<?xml version="1.0" encoding="utf-8"?>
<!--
  포트폴리오 위젯 — 4x3 셀.
  상단: 총평가 + 수익률 + 예수금 요약  |  하단: 보유 종목 스크롤 리스트.
  RemoteViews-safe: LinearLayout + TextView + ListView 만 사용.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_bg"
        android:padding="12dp">

        <!-- 헤더 -->
        <LinearLayout
            android:id="@+id/widget_portfolio_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📊 ArQuant"
                android:textColor="#6366F1"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_portfolio_refresh"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="↻"
                android:textColor="#94A3B8"
                android:textSize="18sp"
                android:contentDescription="새로고침" />
        </LinearLayout>

        <!-- 요약 (총평가 / 수익률 / 예수금) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_total_eval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="총평가 로딩중..."
                android:textColor="#E2E8F0"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_pnl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#10B981"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="0dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/widget_cash"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="예수금 -"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_holdings_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="보유 -"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 구분선 -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#336366F1"
            android:layout_marginBottom="6dp"
            android:contentDescription="@null" />

        <!-- 보유 종목 리스트 -->
        <ListView
            android:id="@+id/widget_portfolio_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <TextView
            android:id="@+id/widget_portfolio_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="보유 종목 없음"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
