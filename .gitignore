claude_responses.log
*.bak
*.bak.*
backup_*/
backup/
todos.json
memos.json
notifications.json
chat_logs/
user_profile/
profiles/

# ============================================================================
# 런타임 데이터 (CSV / DB / 시뮬 결과 — 재생성 가능)
# ============================================================================
data/*.db
data/*.sqlite*
data/*.csv
data/equity_curve.json
data/cycles.db
