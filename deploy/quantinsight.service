[Unit]
Description=QuantInSight — FastAPI server (구 ArQuant)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arcosium
WorkingDirectory=/home/arcosium/projects/QuantInSight
ExecStart=/usr/bin/python3.12 -m uvicorn server.app:app --host 0.0.0.0 --port 8500
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
