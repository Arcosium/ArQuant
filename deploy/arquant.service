[Unit]
Description=Arquant v1.0 — FastAPI server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/projects/Arquant
ExecStart=/usr/bin/python3.11 -m uvicorn server.app:app --host 0.0.0.0 --port 8500
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
